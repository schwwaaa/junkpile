{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Junkpile 07 · Webcam WebSocket",
    "version": "0.2.0"
  },
  "tauri": {
    "allowlist": { "all": false },
    "windows": [
      {
        "label": "controls",
        "title": "07 · Tauri v1 · Webcam WebSocket Controls",
        "url": "controls.html",
        "width": 500,
        "height": 860,
        "minWidth": 410,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "x": 40,
        "y": 45
      },
      {
        "label": "canvas",
        "title": "07 · Tauri v1 · Webcam WebSocket Output",
        "url": "canvas.html",
        "width": 960,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "x": 560,
        "y": 45
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.schwwaaa.junkpile.v1.webcam-websocket",
      "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"],
      "macOS": { "entitlements": "entitlements.plist" }
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:2727 ws://[::1]:2727; media-src 'self' blob: mediastream:; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
