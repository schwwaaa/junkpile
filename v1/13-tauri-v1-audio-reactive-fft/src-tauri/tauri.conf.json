{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src"
  },
  "package": {
    "productName": "Junkpile 13 · Audio-Reactive FFT",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "13 · Tauri v1 · Audio-Reactive FFT",
        "url": "index.html",
        "width": 1320,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.schwwaaa.junkpile.v1.audio-reactive-fft",
      "icon": [
        "icons/icon.icns",
        "icons/icon.png",
        "icons/icon.ico"
      ],
      "macOS": {
        "entitlements": "entitlements.plist"
      }
    },
    "security": {
      "csp": "default-src 'self'; media-src 'self' blob: mediastream:; img-src 'self' blob: data:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
