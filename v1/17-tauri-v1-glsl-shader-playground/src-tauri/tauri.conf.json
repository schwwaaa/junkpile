{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Junkpile 17 · GLSL Shader Playground",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": { "save": true },
      "fs": { "writeFile": true }
    },
    "windows": [
      {
        "label": "main",
        "title": "17 · Tauri v1 · GLSL Shader Playground",
        "url": "index.html",
        "width": 1540,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.schwwaaa.junkpile.v1.glsl-shader-playground",
      "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"]
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
