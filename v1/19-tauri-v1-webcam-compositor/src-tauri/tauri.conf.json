{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Junkpile 19 · Webcam Compositor",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": { "save": true },
      "fs": { "writeFile": true }
    },
    "windows": [
      {
        "label": "main",
        "title": "19 · Tauri v1 · Webcam Compositor",
        "url": "index.html",
        "width": 1480,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.schwwaaa.junkpile.v1.webcam-compositor",
      "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"],
      "macOS": { "entitlements": "entitlements.plist" }
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob: data: mediastream:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
