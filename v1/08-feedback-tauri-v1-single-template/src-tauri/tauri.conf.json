{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Junkpile 08 · Feedback Single Window",
    "version": "0.2.0"
  },
  "tauri": {
    "allowlist": { "all": false },
    "windows": [
      {
        "label": "main",
        "title": "08 · Tauri v1 · Feedback Single Window",
        "url": "index.html",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.schwwaaa.junkpile.v1.feedback-single-window",
      "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"],
      "macOS": { "entitlements": "entitlements.plist" }
    },
    "security": {
      "csp": "default-src 'self'; media-src 'self' blob: mediastream:; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
