{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Junkpile 22 · Image Sequence Player",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": { "open": true, "save": true },
      "fs": { "writeFile": true },
      "protocol": { "asset": true, "assetScope": ["**"] },
      "window": { "all": true }
    },
    "windows": [
      {
        "label": "controls",
        "title": "22 · Tauri v1 · Image Sequence Player Controls",
        "url": "index.html",
        "width": 530,
        "height": 950,
        "minWidth": 460,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      },
      {
        "label": "output",
        "title": "22 · Image Sequence Output",
        "url": "output.html",
        "width": 1280,
        "height": 720,
        "minWidth": 480,
        "minHeight": 270,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "x": 550,
        "y": 80
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.schwwaaa.junkpile.v1.image-sequence-player",
      "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"]
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: asset: https://asset.localhost; media-src 'self' blob: data: asset: https://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
