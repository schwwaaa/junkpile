{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Junkpile 03 · Raw WebGL WebSocket",
    "version": "0.2.0"
  },
  "tauri": {
    "allowlist": {
      "all": false
    },
    "windows": [
      {
        "label": "controls",
        "title": "03 · Tauri v1 · Raw WebGL WebSocket Controls",
        "url": "controls.html",
        "width": 470,
        "height": 820,
        "minWidth": 390,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "x": 40,
        "y": 50
      },
      {
        "label": "canvas",
        "title": "03 · Tauri v1 · Raw WebGL WebSocket Output",
        "url": "canvas.html",
        "width": 960,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "x": 530,
        "y": 50
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.schwwaaa.junkpile.v1.webgl-websocket",
      "icon": [
        "icons/icon.icns",
        "icons/icon.png",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:2727 ws://[::1]:2727; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
