{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Junkpile 20 · Live Video Switcher",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": { "save": true },
      "fs": { "writeFile": true }
    },
    "windows": [
      {
        "label": "main",
        "title": "20 · Tauri v1 · Live Video Switcher",
        "url": "index.html",
        "width": 1540,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 740,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.schwwaaa.junkpile.v1.live-video-switcher",
      "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"],
      "macOS": { "entitlements": "entitlements.plist" }
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob: data: mediastream:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
