{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile wgpu Audio Reactive FFT",
  "version": "0.1.2",
  "identifier": "com.schwwaaa.junkpile.wgpu.audio.reactive.fft",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "controls",
        "title": "Junkpile · Audio Reactive FFT",
        "url": "index.html",
        "width": 1320,
        "height": 920,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
