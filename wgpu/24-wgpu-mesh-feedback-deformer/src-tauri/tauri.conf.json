{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile 24 · Mesh Feedback Deformer",
  "version": "0.1.0",
  "identifier": "com.schwwaaa.junkpile.wgpu-mesh-feedback-deformer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "controls",
        "title": "Junkpile 24 · Mesh Feedback Deformer · Controls",
        "url": "index.html",
        "width": 960,
        "height": 1020,
        "minWidth": 540,
        "minHeight": 720,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
