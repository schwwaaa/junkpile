{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile wgpu FFmpeg Record",
  "version": "0.1.0",
  "identifier": "com.schwwaaa.junkpile.28.wgpu.ffmpeg.record",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "controls",
        "title": "Junkpile 28 · FFmpeg Record · Controls",
        "url": "index.html",
        "width": 1040,
        "height": 900,
        "minWidth": 680,
        "minHeight": 650,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
