{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile wgpu IO Config Foundation",
  "version": "0.1.0",
  "identifier": "com.schwwaaa.junkpile.26.wgpu.io.config.foundation",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "controls",
        "title": "Junkpile 26 · I/O Config Foundation · Controls",
        "url": "index.html",
        "width": 900,
        "height": 860,
        "minWidth": 560,
        "minHeight": 620,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
