{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile wgpu Cross Platform Output Router",
  "version": "0.1.0",
  "identifier": "com.schwwaaa.junkpile.39.wgpu.cross.platform.output.router",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "controls",
        "title": "Junkpile 39 · Cross-Platform Output Router · Controls",
        "url": "index.html",
        "width": 1120,
        "height": 920,
        "minWidth": 720,
        "minHeight": 680,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [
        "./vendor/Syphon.framework"
      ]
    }
  }
}
