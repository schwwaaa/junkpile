{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile wgpu Audio Reactive Spectrum",
  "version": "0.1.0",
  "identifier": "com.schwwaaa.junkpile.wgpu.audio.reactive.spectrum",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "controls",
        "title": "Junkpile wgpu Audio Reactive Spectrum · Controls",
        "url": "index.html",
        "width": 1080,
        "height": 980,
        "minWidth": 580,
        "minHeight": 680,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
