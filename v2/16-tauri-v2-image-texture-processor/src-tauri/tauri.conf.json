{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile 16 · Tauri v2 Image Texture Processor",
  "version": "0.1.0",
  "identifier": "com.schwwaaa.junkpile.tauri-v2-image-texture-processor",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "16 · Tauri v2 Image Texture Processor",
        "url": "index.html",
        "width": 1420,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: asset: http://asset.localhost https://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
