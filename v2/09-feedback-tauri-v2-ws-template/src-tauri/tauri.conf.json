{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile 09 — Feedback Lab WS",
  "version": "0.2.0",
  "identifier": "com.schwwaaa.junkpile.feedback-v2-ws",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "controls",
        "title": "Junkpile 09 — Feedback Controls",
        "url": "controls.html",
        "width": 480,
        "height": 820,
        "minWidth": 390,
        "minHeight": 580,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "x": 24,
        "y": 44
      },
      {
        "label": "canvas",
        "title": "Junkpile 09 — Feedback Renderer",
        "url": "canvas.html",
        "width": 940,
        "height": 700,
        "minWidth": 500,
        "minHeight": 360,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "x": 524,
        "y": 44
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:2727 ws://[::1]:2727; media-src 'self' blob: mediastream:; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon_32x32.png",
      "icons/icon_128x128.png",
      "icons/icon_256x256.png",
      "icons/icon_512x512.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
