{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile 12 \u00b7 Tauri v2 Video Texture Player",
  "version": "0.1.0",
  "identifier": "com.schwwaaa.junkpile.tauri-v2-video-texture-player",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "12 \u00b7 Tauri v2 Video Texture Player",
        "url": "index.html",
        "width": 1320,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: asset: http://asset.localhost https://asset.localhost; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
