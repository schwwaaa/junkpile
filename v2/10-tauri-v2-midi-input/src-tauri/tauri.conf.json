{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile 10 · Tauri v2 MIDI Input",
  "version": "0.1.0",
  "identifier": "com.schwwaaa.junkpile.tauri-v2-midi-input",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "10 · Tauri v2 MIDI Input",
        "url": "index.html",
        "width": 1220,
        "height": 780,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
