{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile 10 \u00b7 Tauri v2 MIDI Input",
  "version": "0.1.0",
  "identifier": "com.schwwaaa.junkpile.tauri-v2-midi-input",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "10 \u00b7 Tauri v2 MIDI Input",
        "url": "index.html",
        "width": 1320,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data: asset: http://asset.localhost https://asset.localhost; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon_32x32.png",
      "icons/icon_128x128.png",
      "icons/icon_256x256.png",
      "icons/icon_512x512.png",
      "icons/icon.ico"
    ]
  }
}
