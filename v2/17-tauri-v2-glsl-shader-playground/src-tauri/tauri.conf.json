{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile 17 · Tauri v2 GLSL Shader Playground",
  "version": "0.1.0",
  "identifier": "com.schwwaaa.junkpile.tauri-v2-glsl-shader-playground",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "17 · Tauri v2 · GLSL Shader Playground",
        "url": "index.html",
        "width": 1540,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"]
  }
}
