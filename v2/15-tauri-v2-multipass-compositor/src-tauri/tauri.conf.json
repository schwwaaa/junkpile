{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile 15 · Tauri v2 Multipass Compositor",
  "version": "0.1.0",
  "identifier": "com.schwwaaa.junkpile.tauri-v2-multipass-compositor",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "15 · Tauri v2 Multipass Compositor",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 1020,
        "minHeight": 680,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
