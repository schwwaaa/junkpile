{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile 00 · Tauri v2 p5.js Single Window",
  "version": "0.2.0",
  "identifier": "com.schwwaaa.junkpile.v2.p5-single-window",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "00 · Tauri v2 · p5.js Single Window",
        "url": "index.html",
        "width": 1240,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
