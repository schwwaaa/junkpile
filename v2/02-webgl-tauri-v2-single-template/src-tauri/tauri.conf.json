{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile 02 — Raw WebGL",
  "version": "0.2.0",
  "identifier": "com.schwwaaa.junkpile.webgl-v2-single",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Junkpile 02 — Raw WebGL Single Window",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon_32x32.png",
      "icons/icon_128x128.png",
      "icons/icon_256x256.png",
      "icons/icon_512x512.png",
      "icons/icon.ico"
    ]
  }
}
