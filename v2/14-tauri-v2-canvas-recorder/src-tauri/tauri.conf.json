{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile 14 · Tauri v2 Canvas Recorder",
  "version": "0.1.0",
  "identifier": "com.schwwaaa.junkpile.tauri-v2-canvas-recorder",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "14 · Tauri v2 Canvas Recorder",
        "url": "index.html",
        "width": 1320,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' blob: mediastream:; img-src 'self' blob: data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
