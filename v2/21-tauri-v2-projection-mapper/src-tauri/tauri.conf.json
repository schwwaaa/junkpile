{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junkpile 21 · Tauri v2 Projection Mapper",
  "version": "0.1.0",
  "identifier": "com.schwwaaa.junkpile.tauri-v2-projection-mapper",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "controls",
        "title": "21 · Tauri v2 Projection Mapper Controls",
        "url": "index.html",
        "width": 540,
        "height": 940,
        "minWidth": 460,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": true
      },
      {
        "label": "output",
        "title": "21 · Tauri v2 Projection Output",
        "url": "output.html",
        "width": 1280,
        "height": 720,
        "minWidth": 480,
        "minHeight": 270,
        "resizable": true,
        "decorations": true,
        "x": 560,
        "y": 80
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: data: asset: http://asset.localhost https://asset.localhost mediastream:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"],
    "macOS": { "entitlements": "entitlements.plist" }
  }
}
